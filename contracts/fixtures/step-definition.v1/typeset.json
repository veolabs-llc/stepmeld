{
  "contract": "stepmeld/step-definition.v1",
  "done_by": "performer",
  "inputs": [
    {
      "name": "text",
      "required": true,
      "tag": "text"
    },
    {
      "name": "notes",
      "required": true,
      "tag": "notes"
    }
  ],
  "name": "typeset",
  "outputs": [
    {
      "name": "document",
      "tag": "document"
    }
  ],
  "parameters": [
    {
      "default": 600,
      "name": "dpi",
      "required": false,
      "tag": "integer"
    }
  ],
  "policy": {
    "on_failure": {
      "classes": [
        "lost"
      ],
      "do": "retake",
      "max": 1
    },
    "on_stale": "wait",
    "placement": {
      "confirm": [
        "cloud"
      ]
    },
    "start": "automatic"
  },
  "program": "typeset-program",
  "requires": [
    "fonts-full"
  ],
  "needs": {
    "memory_gib": 8,
    "dpi_max": 1200
  },
  "version": 1
}
