{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stepmeld/workflow-definition.v1",
  "title": "A WorkflowDefinition: named uses of verbs, each with what it sets apart from the verb (Parameter values, a Policy, a nested WorkflowDefinition inline), and the Bindings between them. Holds no Values of a Workflow's own and declares no face of its own (it is derived). May have no steps.",
  "type": "object",
  "required": ["contract", "name", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "stepmeld/workflow-definition.v1" },
    "name": { "type": "string", "pattern": "^[^.\\s]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "label": { "type": "string" },
    "description": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "step"], "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[^.\\s]+$" },
          "step": { "$ref": "#/$defs/ref" },
          "label": { "type": "string" },
          "parameters": { "type": "object", "description": "Parameter values this use starts from instead of the verb's defaults, by name." },
          "policy": { "$ref": "#/$defs/policy", "description": "The Step's rules, in place of the verb's." },
          "definition": { "$ref": "#", "description": "The nested WorkflowDefinition this use is an occurrence of, carried inline; `step` names it." }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object", "required": ["from", "to"], "additionalProperties": false,
        "properties": { "from": { "$ref": "#/$defs/portref" }, "to": { "$ref": "#/$defs/portref" }, "guard": { "$ref": "#/$defs/guard" } }
      }
    }
  },
  "$defs": {
    "locality": {
      "enum": [
        "this-machine",
        "local-network",
        "cloud"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "enum": [
            "automatic",
            "manual"
          ],
          "default": "automatic"
        },
        "on_failure": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "do"
              ],
              "additionalProperties": false,
              "properties": {
                "do": {
                  "const": "stop"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "do",
                "max",
                "classes"
              ],
              "additionalProperties": false,
              "properties": {
                "do": {
                  "const": "retake"
                },
                "max": {
                  "type": "integer",
                  "minimum": 0
                },
                "classes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "on_stale": {
          "enum": [
            "wait",
            "rerun"
          ],
          "default": "wait"
        },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "performer": {
              "type": "string"
            },
            "locality": {
              "$ref": "#/$defs/locality",
              "description": "Where the driver's choice is made, when no Performer is named."
            },
            "confirm": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/locality"
              }
            }
          }
        }
      }
    },
    "ref": { "type": "object", "required": ["name", "version"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "version": { "type": "integer", "minimum": 1 } } },
    "portref": { "type": "string", "pattern": "^[^.\\s]+\\.[^\\s]+$", "description": "step.port" },
    "guard": {
      "oneOf": [
        { "type": "object", "required": ["decision"], "additionalProperties": false, "properties": { "decision": { "type": "object", "required": ["step", "output", "is"], "additionalProperties": false, "properties": { "step": { "type": "string" }, "output": { "type": "string" }, "is": { "type": "string" } } } } },
        { "type": "object", "required": ["status"], "additionalProperties": false, "properties": { "status": { "type": "object", "required": ["step", "is"], "additionalProperties": false, "properties": { "step": { "type": "string" }, "is": { "enum": ["succeeded", "failed", "skipped"] } } } } },
        { "type": "object", "required": ["present"], "additionalProperties": false, "properties": { "present": { "type": "object", "required": ["step", "output"], "additionalProperties": false, "properties": { "step": { "type": "string" }, "output": { "type": "string" } } } } },
        { "type": "object", "required": ["all"], "additionalProperties": false, "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/guard" } } } },
        { "type": "object", "required": ["any"], "additionalProperties": false, "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/guard" } } } },
        { "type": "object", "required": ["not"], "additionalProperties": false, "properties": { "not": { "$ref": "#/$defs/guard" } } }
      ]
    }
  }
}
